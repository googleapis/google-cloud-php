            "clients": {
                "grpc": {
                    "libraryClient": "ProductReviewsServiceClient",
                    "rpcs": {
                        "DeleteProductReview": {
                            "methods": [
                                "deleteProductReview"
                            ]
                        },
                        "GetProductReview": {
                            "methods": [
                                "getProductReview"
                            ]
                        },
                        "InsertProductReview": {
                            "methods": [
                                "insertProductReview"
                            ]
                        },
                        "ListProductReviews": {
                            "methods": [
                                "listProductReviews"
                            ]
                        }
                    }
                }
            }
        }
    }
}