                            "methods": [
                                "createServer"
                            ]
                        },
                        "CreateUser": {
                            "methods": [
                                "createUser"
                            ]
                        },
                        "DeleteServer": {
                            "methods": [
                                "deleteServer"
                            ]
                        },
                        "DeleteUser": {
                            "methods": [
                                "deleteUser"
                            ]
                        },
                        "GetServer": {
                            "methods": [
                                "getServer"
                            ]
                        },
                        "GetUser": {
                            "methods": [
                                "getUser"
                            ]
                        },
                        "ListServers": {
                            "methods": [
                                "listServers"
                            ]
                        },
                        "ListUsers": {
                            "methods": [
                                "listUsers"
                            ]
                        },
                        "StartServer": {
                            "methods": [
                                "startServer"
                            ]
                        },
                        "StopServer": {
                            "methods": [
                                "stopServer"
                            ]
                        },
                        "UpdateServer": {
                            "methods": [
                                "updateServer"
                            ]
                        },
                        "UpdateUser": {
                            "methods": [
                                "updateUser"
                            ]
                        },
                        "GetLocation": {
                            "methods": [
                                "getLocation"
                            ]
                        },
                        "ListLocations": {
                            "methods": [
                                "listLocations"
                            ]
                        }
                    }
                }
            }
        }
    }
}